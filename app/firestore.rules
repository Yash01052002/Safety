rules_version = '2';

// Security model: a user owns their profile and contacts. SOS events are
// created by their author; guardians read an event only via the web track
// link path (handled server-side / with a share token), not broad reads.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /sosEvents/{eventId} {
      // Author can create and update their own events.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, read: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      // Live track points: author writes; reads for guardians are served by a
      // Cloud Function / signed track link, not direct client reads.
      match /track/{pointId} {
        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/sosEvents/$(eventId))
                          .data.userId == request.auth.uid;
      }
    }
  }
}
