rules_version = '2';

// Security model: a user owns their profile and contacts. SOS events are
// created by their author; guardians read an event only via the web track
// link path (handled server-side / with a share token), not broad reads.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /sosEvents/{eventId} {
      // Author can create and update their own events.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, read: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      // Private track points: author writes; guardians read the public
      // projection below, not this subcollection.
      match /track/{pointId} {
        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/sosEvents/$(eventId))
                          .data.userId == request.auth.uid;
      }
    }

    // Proactive live-share sessions — private to their owner. The guardian-
    // visible data lives in publicTracks below.
    match /liveSessions/{sessionId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null
                          && resource.data.userId == request.auth.uid;
    }

    // Public, capability-URL-scoped live track read by the guardian web page.
    // The document id is the opaque event link; anyone holding it can read the
    // minimal location projection. Writes come only from the event's author
    // (client) or the Cloud Function (admin bypasses rules). This trades a
    // small amount of link-guessing risk for a zero-friction, no-login page —
    // Phase 5 hardening can swap the id for a random share token + expiry.
    match /publicTracks/{eventId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }
  }
}
